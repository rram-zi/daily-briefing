{
  "rewrites": [
    { "source": "/api/notion/:path+", "destination": "/api/notion?path=:path+" }
  ],
  "crons": [
    { "path": "/api/cron-notify",  "schedule": "30 15 * * *" },
    { "path": "/api/cron-morning", "schedule": "0 23 * * *" },
    { "path": "/api/cron-check",         "schedule": "0 6 * * *"  },
    { "path": "/api/cron-weekly-report", "schedule": "0 1 * * 0"  }
  ]
}
